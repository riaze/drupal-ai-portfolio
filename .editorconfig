# EditorConfig: https://editorconfig.org
# Follows the Drupal coding standards for PHP, Twig, YAML, CSS and JS.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[composer.{json,lock}]
indent_size = 4
