{#
/**
 * @file
 * One FAQ category: heading, then questions as native disclosure widgets
 * (<details>, keyboard accessible, no JavaScript).
 */
#}
<section class="faq-group">
  {% if title %}
    <h2>{{ title }}</h2>
  {% endif %}
  {% for row in rows %}
    {{ row.content }}
  {% endfor %}
</section>
