<?xml version="1.0" encoding="UTF-8"?>
<!-- PHP_CodeSniffer: Drupal and DrupalPractice standards on custom code. -->
<ruleset name="portfolio">
  <description>Drupal coding standards for the custom modules, the theme and settings.php.</description>

  <file>web/modules/custom</file>
  <file>web/themes/custom</file>
  <file>web/sites/default/settings.php</file>
  <file>scripts</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,md,yml,css"/>
  <arg name="cache" value=".phpcs-cache"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
