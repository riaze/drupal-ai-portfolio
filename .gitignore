# ---------------------------------------------------------------------------
# Secrets and local environment: never commit these.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Local tool settings
.claude/settings.local.json
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Drupal (composer root: drupal/, docroot: drupal/web)
# Everything under web/ is generated by Composer except custom code and
# settings.php, which reads secrets from the environment.
# ---------------------------------------------------------------------------
/drupal/vendor/
/drupal/web/*
!/drupal/web/modules/
/drupal/web/modules/*
!/drupal/web/modules/custom/
!/drupal/web/themes/
/drupal/web/themes/*
!/drupal/web/themes/custom/
!/drupal/web/sites/
/drupal/web/sites/*
!/drupal/web/sites/default/
/drupal/web/sites/default/*
!/drupal/web/sites/default/settings.php
/drupal/private/
/drupal/.phpunit.cache/
/drupal/.phpunit.result.cache
/drupal/.phpcs-cache
/drupal/.phpstan-cache/

# ---------------------------------------------------------------------------
# Python (ai-service/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Reports and build output
# ---------------------------------------------------------------------------
/reports/
node_modules/
